# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# OneBot 11 HTTP API 根地址（必填）
QQ_BOT_API_URL=http://127.0.0.1:3000

# 推送目标：group 表示 QQ 群，private 表示 QQ 私聊
QQ_TARGET_TYPE=group

# 群号或接收人的 QQ 号（必填）
QQ_TARGET_ID=123456789

# OneBot access token（未启用鉴权时留空）
QQ_BOT_ACCESS_TOKEN=
